{
  "manifest_version": 3,
  "name": "SlopLens",
  "version": "2.0.0",
  "description": "Instant slop score on any webpage. Detects low-quality AI-generated content in real time.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SlopLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["config.js", "content.js"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js" }
}