# Required: Get FREE key at https://console.groq.com (no credit card needed)
GROQ_API_KEY=gsk_...

# Optional: GitHub token for higher rate limits (60/hr → 5000/hr)
# Get free token: github.com → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=ghp_...

# Optional: restrict CORS origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
